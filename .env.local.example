# Copy this file to .env.local and fill in your own values.
# .env.local is already gitignored — never commit real secrets, and never
# create or edit this file through the GitHub website. Real secrets belong
# only on your own computer (here) and in your hosting provider's own
# "Environment Variables" settings screen when you deploy.

# --- Supabase (required) ---------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (Project Settings -> API -> service_role). SECRET — only
# used server-side by the email reminder cron job to read every user's
# upcoming interviews. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Assistant (optional) ------------------------------------------------
# Enables the /assistant page. Set ONE of these — Groq has a free tier.
# Without either key the page still loads and explains it needs configuring.
GROQ_API_KEY=
GROQ_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Email reminders (optional) --------------------------------------------
# Sends interview reminder emails 1 day and 1 hour before. Get a key at
# resend.com. RESEND_FROM_EMAIL must be a verified sender/domain in Resend
# (for quick testing without your own domain, "onboarding@resend.dev" works).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# A password only your cron job knows, so nobody else can trigger reminder
# emails by guessing the URL. Make up any random string.
CRON_SECRET=

# --- Daily Blessings / YouTube (optional) -----------------------------------
# Get a free API key at console.cloud.google.com (enable "YouTube Data API v3").
YOUTUBE_API_KEY=
# Channel handle without the @ — defaults to frmathewvayalamannil if unset.
YOUTUBE_CHANNEL_HANDLE=frmathewvayalamannil
