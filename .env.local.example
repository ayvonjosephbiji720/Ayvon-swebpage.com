# Copy this file to .env.local and fill in your own values.
# .env.local is already gitignored — never commit real secrets.

# --- Supabase (required) ---------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI Assistant (optional) ------------------------------------------------
# Enables the /assistant page. Without this key the page still loads and
# explains that the assistant needs to be configured.
OPENAI_API_KEY=
# Defaults to gpt-4o-mini if unset.
OPENAI_MODEL=
